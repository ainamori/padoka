# Padoka docker compose 用の環境変数の例。
# コピーして .env として利用できます（docker compose は同じディレクトリの .env を自動で読む）。
#
#   cp .env.example .env

# IRC クライアントポート（デフォルト 6667）。
# PADOKA_CLIENT_PORT    = コンテナ内のポート（config の client_server.port と
#                          一致させる。3389 等に変える場合はこちら）
# PADOKA_CLIENT_HOST_PORT = ホスト側に公開するポート（未設定なら PADOKA_CLIENT_PORT と同じ）
# 例: config の client_server.port を 3389 にしたとき
#   PADOKA_CLIENT_PORT=3389 docker compose up -d
PADOKA_CLIENT_PORT=6667
#PADOKA_CLIENT_HOST_PORT=6667

# ホスト側に公開する WebUI ポート（デフォルト 8080）。
# WebUI は config/padoka.yml の webui.enabled: true で有効化。
PADOKA_WEBUI_PORT=8080

# タイムゾーン（ログのタイムスタンプに反映）
TZ=UTC
