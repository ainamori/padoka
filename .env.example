# Padoka docker compose 用の環境変数の例。
# コピーして .env として利用できます（docker compose は同じディレクトリの .env を自動で読む）。
#
#   cp .env.example .env

# ホスト側に公開する IRC クライアントポート（デフォルト 6667）。
# 6667 が使用中のときは 16667 等に変更する。
#   PADOKA_CLIENT_PORT=16667 docker compose up -d
PADOKA_CLIENT_PORT=6667

# タイムゾーン（ログのタイムスタンプに反映）
TZ=UTC
